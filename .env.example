PORT=3000
NODE_ENV=development
WEBHOOK_SECRET=change-me-use-a-long-random-string-at-least-32-chars
MAINTENANCE_MODE=false

# ── TextBee (primary provider) ───────────────────────────────────────────────
# Get your API key from https://app.textbee.dev/dashboard → API Keys
TEXTBEE_API_KEY=
# Optional: pin a specific device. Leave blank to use your default device.
TEXTBEE_DEVICE_ID=
# Webhook signing secret (set this in the TextBee dashboard under Webhooks)
TEXTBEE_WEBHOOK_SECRET=change-me-textbee-webhook-secret-min-20-chars
# Dual-SIM phones only: get simSubscriptionId from TextBee app → Settings → SIM section
# Leave blank to use the default SIM
TEXTBEE_SIM_SUBSCRIPTION_ID=

# ── Africa's Talking (secondary / USSD) ──────────────────────────────────────
# Dashboard: https://account.africastalking.com → select your app → Settings → API Key
# For sandbox testing: AT_USERNAME=sandbox, use the sandbox API key
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# Active SMS provider: "textbee" or "africastalking"
SMS_PROVIDER=textbee

# ── Gemini ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
# Check https://ai.google.dev/gemini-api/docs/models for current model IDs.
# Flash-Lite-class recommended for speed and cost.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PRICE_IN_PER_M=0.075
GEMINI_PRICE_OUT_PER_M=0.30

# ── Credits & limits ─────────────────────────────────────────────────────────
FREE_TRIAL_CREDITS=3
MAX_SEGMENTS=2
RATE_LIMIT_PER_MIN=5
RATE_LIMIT_PER_DAY=30

# ── Credit packs (KES:credits) – Phase 3 placeholders ────────────────────────
CREDIT_PACKS=20:10,50:30,100:70

# ── Phase 3: Daraja M-Pesa ────────────────────────────────────────────────────
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
